# Generated by `./lab render` into rendered/caddy/Caddyfile. Edit
# stacks/caddy/Caddyfile.base or a stack's caddy.conf, not the copy.
{
	email {$ACME_EMAIL}
}

# One wildcard certificate for every service, so individual hostnames never
# show up in public certificate transparency logs.
*.{$DOMAIN} {
	import tls.conf
	import sites/*.conf

	handle {
		abort
	}
}

# Extra top-level sites from the private overlay (LOCAL_DIR/caddy/*.caddy),
# e.g. a plain-HTTP block on a loopback port for a tunnel.
import extra/*.caddy
