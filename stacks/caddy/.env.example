# Cloudflare API token for DNS-01 certificates (TLS_MODE=cloudflare only).
# dash.cloudflare.com -> My Profile -> API Tokens -> "Edit zone DNS"
# template, limited to your zone.
CF_API_TOKEN=
# Managed: Glances' login as a Basic auth header, so its route logs in for
# you (from GLANCES_PASSWORD in stacks/glances/.env).
GLANCES_BASIC_AUTH=
