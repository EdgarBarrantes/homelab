# Generated. Database password (user wger).
POSTGRES_PASSWORD=
# Generated. Password of PowerSync's storage role in the same database.
POWERSYNC_PASSWORD=
# Generated. Django's secret key (sessions, CSRF).
WGER_SECRET_KEY=
# Generated. Password of the "admin" login (replaces wger's default on
# first start): ./lab secret wger WGER_ADMIN_PASSWORD
WGER_ADMIN_PASSWORD=
# Generated. Private half of the RS256 key pair (a base64 JWK) that signs
# the mobile app's logins and PowerSync tokens.
JWT_PRIVATE_KEY=
# Generated. Public half of that key pair.
JWT_PUBLIC_KEY=
