# Generated. Password of the "kismet" login (web UI and API):
# ./lab secret kismet KISMET_PASSWORD
KISMET_PASSWORD=
# The USB Wi-Fi adapter(s) Kismet takes over (monitor mode), space-separated,
# by interface name, e.g. wlx... (ip -br link lists them). Built-in cards and
# an adapter this machine is online through are always refused. Empty:
# Kismet runs without one.
# ./lab config kismet KISMET_SOURCE <interface>
KISMET_SOURCE=
# Channels to hop over, comma-separated, e.g. 1,6,11,36,40 (plain numbers:
# 20 MHz only; Kismet also takes 36HT40+, 36VHT80). Empty: every channel and
# width the adapter offers. A list helps when a driver complains about some
# combination (Realtek rtw88 logs a warning for 161+165 as one 40 MHz channel).
KISMET_CHANNELS=
# Days to keep Kismet's logs (./data/*.kismet); older ones are deleted at start.
KISMET_KEEP_DAYS=30
