# Any value turns the server's cache off (streams aren't kept on disk). Empty:
# cached, up to the size set in the player (Settings > Streaming).
# ./lab config stremio STREMIO_NO_CACHE 1
STREMIO_NO_CACHE=
# GPU render node for hardware transcoding, e.g. /dev/dri/renderD128 (the
# vendor of each: cat /sys/class/drm/renderD*/device/vendor; 0x8086 Intel,
# 0x1002 AMD). Empty: transcoding on the CPU.
# ./lab config stremio VAAPI_DEVICE /dev/dri/renderD128
VAAPI_DEVICE=
# VPN for all of Stremio's traffic (gluetun, WireGuard). Empty: no VPN. A
# gluetun provider name, e.g. protonvpn, mullvad, airvpn, privado.
# ./lab config stremio VPN_PROVIDER protonvpn
VPN_PROVIDER=
# The provider's WireGuard private key (PrivateKey in a WireGuard config
# generated on its website; for Proton turn on NAT-PMP there if you want
# port forwarding). ./lab config stremio VPN_WIREGUARD_KEY
VPN_WIREGUARD_KEY=
# Server countries, comma-separated, e.g. Netherlands,Switzerland. Empty: any.
VPN_COUNTRIES=
# on: ask the provider for a forwarded port and use only servers that offer
# one (Proton, PIA, Perfect Privacy, PrivateVPN). Peers can then connect in.
VPN_PORT_FORWARDING=off
