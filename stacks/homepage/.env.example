# Home Assistant long-lived token for the HA widget (only if HA_URL is set):
# HA -> Profile -> Long-Lived Access Tokens. Homepage only substitutes env
# vars named HOMEPAGE_VAR_* in its config.
HOMEPAGE_VAR_HA_TOKEN=
# Managed: Glances' password, for the Glances widgets.
HOMEPAGE_VAR_GLANCES_PASSWORD=
