# The password you choose in Actual's web UI on first visit, re-entered here
# so the HTTP wrapper can log in. Set it with: ./lab config actual-budget
# ACTUAL_SERVER_PASSWORD, then ./lab up actual-budget.
ACTUAL_SERVER_PASSWORD=
# Generated. Authenticates callers of the HTTP wrapper.
ACTUAL_HTTP_API_KEY=
# Which budget the backups export: Actual -> Settings -> Show advanced
# settings -> Sync ID.
ACTUAL_BUDGET_SYNC_ID=
