PAPERLESS_API_TOKEN=
# Same value as ACTUAL_HTTP_API_KEY in stacks/actual-budget/.env.
ACTUAL_HTTP_API_KEY=
# Actual -> Settings -> Show advanced settings -> Sync ID.
ACTUAL_BUDGET_SYNC_ID=
