# Generated. Django's secret key.
PAPERLESS_SECRET_KEY=
# Generated. Database password.
POSTGRES_PASSWORD=
# First admin account's user name, created on first start only.
PAPERLESS_ADMIN_USER=admin
# Generated. First admin account's password (./lab secret paperless-ngx
# PAPERLESS_ADMIN_PASSWORD).
PAPERLESS_ADMIN_PASSWORD=
# Only with PAPERLESS_AI=yes: Paperless -> My Profile -> API token
# (circular-arrow button). Set with: ./lab config paperless-ngx
# PAPERLESS_API_TOKEN
PAPERLESS_API_TOKEN=
# Managed: same value as ACTUAL_HTTP_API_KEY in stacks/actual-budget/.env.
ACTUAL_HTTP_API_KEY=
# Managed: from ACTUAL_BUDGET_SYNC_ID in stacks/actual-budget/.env.
ACTUAL_BUDGET_SYNC_ID=
