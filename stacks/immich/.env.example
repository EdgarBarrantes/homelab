# Read by Immich's upstream docker-compose.yml. UPLOAD_LOCATION and TZ are
# kept in sync with homelab.env (PHOTOS_DIR, TZ) by `./lab render`.
UPLOAD_LOCATION=
DB_DATA_LOCATION=./postgres
TZ=
# Pin the major version; read the release notes before changing it.
IMMICH_VERSION=v3
# Generated. Only A-Za-z0-9.
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
