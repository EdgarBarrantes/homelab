# Managed: where photos live, from PHOTOS_DIR in homelab.env. Read by
# Immich's upstream docker-compose.yml.
UPLOAD_LOCATION=
# Database folder, relative to the stack.
DB_DATA_LOCATION=./postgres
# Managed: from TZ in homelab.env.
TZ=
# Immich major version; read the release notes before changing it.
IMMICH_VERSION=v3
# Generated. Database password (only A-Za-z0-9).
DB_PASSWORD=
# Database user.
DB_USERNAME=postgres
# Database name.
DB_DATABASE_NAME=immich
