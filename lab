#!/usr/bin/env bash
# lab: manage the stacks in this repo (one folder per stack under stacks/).
#
#   lab ls                     all stacks, enabled or not, with descriptions
#   lab status                 running containers, with their tier
#   lab up      [stack...]     render config, start stacks (default: enabled)
#   lab down    [stack...]     stop and remove containers (data is kept)
#   lab restart [stack...]
#   lab stop    [stack...]     stop without removing containers
#   lab pause                  stop only containers labelled lab.tier=heavy
#   lab pause --all            stop every stack
#   lab resume                 start everything enabled again
#   lab logs <stack> [svc]     follow logs
#   lab update  [stack...]     pull new images and recreate
#   lab enable|disable <stack> add/remove a stack (then: lab up)
#   lab sh <stack> <svc>       shell into a container
#   lab compose <stack> ...    any docker compose command, with lab's files
#   lab render                 regenerate Caddy/Homepage/tunnel/backup config
#   lab reload caddy           apply a Caddy config change without downtime
#   lab doctor                 check that everything is healthy
#   lab config <stack> <KEY>   set a value in a stack's .env (asks, hidden)
#   lab secret <stack> <KEY>   print a value from a stack's .env
#   lab keys [stack...|backup] the keys in each .env, documented (never values)
#   lab backup [now|status|log] run or inspect the nightly backup
#   lab restore [--dry-run]    bring data back from the backups (see --help)
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PROXY_NET=proxy
# shellcheck source=lib/common.sh
source "$ROOT/lib/common.sh"
trap on_exit EXIT
# shellcheck source=lib/render.sh
source "$ROOT/lib/render.sh"
# shellcheck source=lib/doctor.sh
source "$ROOT/lib/doctor.sh"
# shellcheck source=lib/restore.sh
source "$ROOT/lib/restore.sh"

load_config || die "no homelab.env yet: run ./install.sh first"

# Use the given stacks, or all enabled ones when none were given.
pick() { if (($#)); then printf '%s\n' "$@"; else enabled_stacks; fi; }

# dc <stack> <compose args...>: docker compose with homelab.env + the
# stack's .env, and each overlay whose switch is on (gpu.yml when GPU=yes).
dc() {
  local s="$1"; shift
  local dir="$STACKS_DIR/$s" f ov var files=() envs=(--env-file "$HOMELAB_ENV")
  [[ -f "$dir/stack.conf" ]] || die "no such stack: $s"
  for f in compose.yml docker-compose.yml docker-compose.override.yml; do
    [[ -f "$dir/$f" ]] && files+=(-f "$dir/$f")
  done
  for ov in $(stack_meta "$s" OVERLAYS); do
    f="${ov%%:*}"; var="${ov#*:}"
    if [[ "$var" == \?* ]]; then  # ?KEY: on when KEY is set in the stack's .env
      [[ -n "$(env_get "$dir/.env" "${var#\?}")" ]] && files+=(-f "$dir/$f")
    else
      is_yes "${!var:-no}" && files+=(-f "$dir/$f")
    fi
  done
  # Private overlay: extra compose files for this stack (use ${LOCAL_DIR}
  # for paths inside them; relative paths resolve against the stack).
  for f in "${LOCAL_DIR:-/nonexistent}/stacks/$s"/*.yml; do
    [[ -f "$f" ]] && files+=(-f "$f")
  done
  [[ -f "$dir/.env" ]] && envs+=(--env-file "$dir/.env")
  docker compose --project-directory "$dir" "${envs[@]}" "${files[@]}" "$@"
}

ensure_net() {
  docker network inspect "$PROXY_NET" >/dev/null 2>&1 \
    || docker network create "$PROXY_NET" >/dev/null
}

caddy_reload() {
  if [[ "$(docker inspect -f '{{.State.Running}}' caddy 2>/dev/null)" == true ]]; then
    docker exec caddy caddy reload --config /etc/caddy/Caddyfile >/dev/null 2>&1 \
      && echo "caddy: config reloaded" || warn "caddy reload failed: ./lab logs caddy"
  fi
}

# set_stacks <list>: write STACKS= back to homelab.env.
set_stacks() {
  STACKS="$(printf '%s\n' $1 | awk 'NF && !seen[$0]++' | tr '\n' ' ' | sed 's/ $//')"
  env_set "$HOMELAB_ENV" STACKS "$STACKS"
}

# keys <name> <.env> <.env.example> <generated keys>: every key the stack's
# .env.example documents or its .env holds, never a value. Origin from the
# comment above the key: "Generated." (lab makes it), "Managed:" (lab render
# rewrites it), else yours to set. Full comments with --long. Keys a private
# overlay adds are documented in LOCAL_DIR/stacks/<stack>/.env.example.
keys() {
  local name="$1" env="$2" ex="$3" gen=" $4 " long="${KEYS_LONG:-}" line k f block="" desc origin state w=0 room
  local -a order=(); local -A doc=()
  # The stack's own example, then the private overlay's (keys it adds).
  for f in "$ex" "${LOCAL_DIR:-/nonexistent}/stacks/$name/.env.example"; do
    [[ -f "$f" ]] || continue
    block=""
    while IFS= read -r line; do
      if [[ "$line" =~ ^#\ ?(.*)$ ]]; then block+="${BASH_REMATCH[1]} "
      elif [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)= ]]; then
        k="${BASH_REMATCH[1]}"; [[ -v "doc[$k]" ]] || order+=("$k"); doc[$k]="${block% }"; block=""
      else block=""; fi
    done < "$f"
  done
  if [[ -f "$env" ]]; then
    while IFS= read -r k; do
      [[ -v "doc[$k]" ]] || { doc[$k]=""; order+=("$k"); }
    done < <(sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$env" | awk '!seen[$0]++')
  fi
  ((${#order[@]})) || return 0
  for k in "${order[@]}"; do ((${#k} > w)) && w=${#k}; done
  printf '%s%s%s %s%s%s\n' "$C_B" "$name" "$C_0" "$C_DIM" "${env#"$ROOT"/}" "$C_0"
  for k in "${order[@]}"; do
    desc="${doc[$k]}"
    if [[ "$gen" == *" $k "* || "$desc" == Generated* ]]; then origin=generated
    elif [[ "$desc" == Managed* ]]; then origin=managed
    elif [[ -n "$desc" ]]; then origin=yours
    else origin=undocumented; fi
    desc="${desc#Generated. }"; desc="${desc#Managed: }"
    if [[ -n "$(env_get "$env" "$k")" ]]; then state="${C_GRN}set  ${C_0}"; else state="${C_YLW}empty${C_0}"; fi
    if [[ -n "$long" ]]; then
      printf '  %-*s  %s  %-12s\n' "$w" "$k" "$state" "$origin"
      [[ -n "$desc" ]] && fold -s -w 72 <<<"$desc" | sed "s/^/      $C_DIM/; s/\$/$C_0/"
    else
      # First sentence, cut at a word to fit the terminal.
      desc="${desc%%. *}"; room=$(( ${COLUMNS:-$(tput cols 2>/dev/null || echo 100)} - w - 25 ))
      if ((room < 20)); then desc=""
      elif ((${#desc} > room)); then desc="${desc:0:room-3}"; desc="${desc% *}..."; fi
      printf '  %-*s  %s  %-12s %s%s%s\n' "$w" "$k" "$state" "$origin" "$C_DIM" "$desc" "$C_0"
    fi
  done
}

cmd="${1:-status}"; shift || true
case "$cmd" in
  ls)
    for s in $(all_stacks); do
      if is_enabled "$s"; then mark="${C_GRN}on ${C_0}"; else mark="${C_DIM}off${C_0}"; fi
      printf '  %s  %-20s %s\n' "$mark" "$s" "$(stack_meta "$s" DESCRIPTION)"
    done ;;
  status|ps)
    docker ps -a --filter label=com.docker.compose.project \
      --format 'table {{.Label "com.docker.compose.project"}}\t{{.Names}}\t{{.Status}}\t{{.Label "lab.tier"}}' ;;
  up|resume)
    render_all
    ensure_net
    for s in $(pick "$@"); do echo "== $s"; dc "$s" up -d --build --remove-orphans; done
    caddy_reload ;;
  down)
    for s in $(pick "$@" | tac); do echo "== $s"; dc "$s" down; done ;;
  restart)
    for s in $(pick "$@"); do echo "== $s"; dc "$s" restart; done ;;
  stop)
    for s in $(pick "$@" | tac); do echo "== $s"; dc "$s" stop; done ;;
  pause)
    if [[ "${1:-}" == "--all" ]]; then
      for s in $(enabled_stacks | tac); do echo "== $s"; dc "$s" stop; done
    else
      ids="$(docker ps -q --filter label=lab.tier=heavy)"
      # shellcheck disable=SC2086
      [[ -n "$ids" ]] && docker stop $ids || echo "nothing heavy running"
    fi ;;
  logs)
    [[ $# -ge 1 ]] || die "usage: lab logs <stack> [service]"
    s="$1"; shift; dc "$s" logs -f --tail 100 "$@" ;;
  update|pull)
    render_all
    ensure_net
    for s in $(pick "$@"); do echo "== $s"; dc "$s" pull --ignore-buildable && dc "$s" up -d --build; done
    docker image prune -f ;;
  enable)
    [[ $# -ge 1 ]] || die "usage: lab enable <stack>..."
    for s in "$@"; do [[ -f "$STACKS_DIR/$s/stack.conf" ]] || die "no such stack: $s"; done
    set_stacks "$STACKS $*"
    render_all
    echo "enabled: $*  (start with: ./lab up $*)" ;;
  disable)
    [[ $# -ge 1 ]] || die "usage: lab disable <stack>..."
    new=""; for s in $STACKS; do [[ " $* " == *" $s "* ]] || new+="$s "; done
    set_stacks "$new"
    render_all; caddy_reload
    echo "disabled: $*  (containers still exist until: ./lab down $*)" ;;
  sh)
    [[ $# -eq 2 ]] || die "usage: lab sh <stack> <service>"
    dc "$1" exec "$2" sh -c 'command -v bash >/dev/null && exec bash || exec sh' ;;
  compose)
    [[ $# -ge 2 ]] || die "usage: lab compose <stack> <compose args...>"
    dc "$@" ;;
  render)
    render_all; echo "rendered into $RENDER_DIR and stacks/*/.env" ;;
  reload)
    [[ "${1:-caddy}" == caddy ]] || die "only 'lab reload caddy' exists"
    render_all; caddy_reload ;;
  doctor|check)
    run_doctor || { HOMELAB_DIED=1; exit 1; } ;;
  config)
    [[ $# -eq 2 ]] || die "usage: lab config <stack> <KEY>"
    f="$STACKS_DIR/$1/.env"; [[ -f "$f" ]] || die "no $f (enable the stack and run lab render)"
    read -r -s -p "$2 for $1 (input hidden): " val </dev/tty; echo
    env_set "$f" "$2" "$val"; echo "saved; apply with: ./lab up $1" ;;
  keys)
    [[ "${1:-}" == --long ]] && { KEYS_LONG=1; shift; }
    want="$(pick "$@")"; (($#)) || want+=$'\nbackup'
    for s in $want; do
      if [[ "$s" == backup ]]; then
        keys backup "$ROOT/extras/backup/.env" "$ROOT/extras/backup/.env.example" ""
      else
        [[ -f "$STACKS_DIR/$s/stack.conf" ]] || die "no such stack: $s"
        keys "$s" "$STACKS_DIR/$s/.env" "$STACKS_DIR/$s/.env.example" "$(stack_meta "$s" SECRETS)"
      fi
    done ;;
  secret)
    [[ $# -eq 2 ]] || die "usage: lab secret <stack> <KEY>"
    env_get "$STACKS_DIR/$1/.env" "$2"; echo ;;
  backup)
    case "${1:-status}" in
      now)    sudo systemctl start --no-block homelab-backup.service
              echo "started; follow with: ./lab backup log" ;;
      status) systemctl list-timers homelab-backup.timer --no-pager
              systemctl status homelab-backup.service --no-pager -n 0 || true ;;
      log)    sudo tail -n 50 -f /var/log/homelab-backup.log ;;
      *)      die "usage: lab backup [now|status|log]" ;;
    esac ;;
  restore)
    run_restore "$@" ;;
  help|-h|--help) sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $cmd (try: lab help)" ;;
esac
