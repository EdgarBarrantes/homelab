# Test configuration for tests/vm.sh: no Cloudflare, no Tailscale, no GPU.
HOMELAB_NAME=vmtest
STACKS="caddy homepage glances immich immich-public-proxy paperless-ngx actual-budget gokapi calibre-web backrest anki dawarich"
DOMAIN=homelab.internal
TLS_MODE=internal
ACME_EMAIL=test@example.com
PUBLIC_DOMAIN=example.test
CLOUDFLARED_TUNNEL=
TZ=Europe/Sofia
PUID=1000
PGID=1000
GPU=no
LAN_BIND=127.0.0.1
NET_IFACE=enp5s0
PHOTOS_DIR=/home/ubuntu/Pictures/Immich
BOOKS_DIR="/home/ubuntu/Calibre Library"
BOOKS_IMPORT_DIR=/home/ubuntu/Books/import
PAPERLESS_CONSUME_DIR=/home/ubuntu/Documents/Paperless
PAPERLESS_AI=no
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_OCR_LANGUAGES=
HA_URL=
WEATHER_LABEL=
WEATHER_LAT=
WEATHER_LON=
BACKUP_TARGET=local
BACKUP_DIR=/srv/backup
BACKUP_SMB_SHARE=
BACKUP_SCHEDULE=daily
BACKUP_RETAIN_DAYS=14
BACKREST_REPO=main
LOCAL_DIR=/home/ubuntu/overlay
