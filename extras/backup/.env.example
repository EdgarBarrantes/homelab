# Optional: where to POST failure alerts (JSON with title and message),
# e.g. a Home Assistant webhook http://<ha>/api/webhook/<random-id>.
BACKUP_NOTIFY_URL=
# Optional dead man's switch: POSTed after every successful run (JSON with
# host, status, snapshot, checked), so a monitor can alert when runs stop.
# A second HA webhook, or a healthchecks.io / Uptime Kuma push URL.
BACKUP_HEARTBEAT_URL=
