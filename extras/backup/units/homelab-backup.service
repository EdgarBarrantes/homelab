# Generated by ./lab render from extras/backup/units. Installed by install.sh.
[Unit]
Description=Nightly homelab backup to ${BACKUP_DIR}
After=docker.service
After=@MOUNT_UNIT@
Requires=@MOUNT_UNIT@
OnFailure=homelab-backup-failed.service

[Service]
Type=oneshot
ExecStart=${ROOT}/extras/backup/backup.sh
# Own log file: a busy journal can rotate a night's run away within hours.
StandardOutput=append:/var/log/homelab-backup.log
StandardError=inherit
