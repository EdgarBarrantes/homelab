# homelab.env: global settings for every stack. install.sh writes this for
# you (wizard); copy it by hand only for a non-interactive install:
#   cp homelab.env.example homelab.env && vim homelab.env
#   ./install.sh --config homelab.env --yes
# Plain KEY=value lines, no spaces around =. Quote values with spaces.
# Per-stack secrets live in stacks/<name>/.env (generated), not here.

# Short name for this server: dashboard title, backup tags.
HOMELAB_NAME=homelab

# Stacks to run (space separated). See `./lab ls` or README for the list.
STACKS="caddy homepage glances"

# --- HTTPS ---------------------------------------------------------------
# Private hostnames are <service>.$DOMAIN, e.g. photos.home.example.com.
DOMAIN=home.example.com
# cloudflare: real certificates via Cloudflare DNS-01 (needs CF_API_TOKEN in
#             stacks/caddy/.env). Point *.$DOMAIN at this server's Tailscale IP.
# internal:   Caddy's own local CA (browsers warn until you trust it). For
#             testing, or a LAN without a domain.
TLS_MODE=cloudflare
ACME_EMAIL=you@example.com

# --- Public links (optional, Cloudflare Tunnel) ---------------------------
# Leave PUBLIC_DOMAIN empty to keep everything private. Otherwise public
# hostnames are <name>.$PUBLIC_DOMAIN (one level deep, so Cloudflare's free
# certificate covers them), e.g. share.example.com.
PUBLIC_DOMAIN=
CLOUDFLARED_TUNNEL=

# --- Machine --------------------------------------------------------------
TZ=Etc/UTC
# Owner of files the containers write into your own folders.
PUID=1000
PGID=1000
# yes: GPU services use the NVIDIA GPU via CDI (see docs/machines.md).
GPU=no
# Address for the few ports other LAN devices need (Ollama, the speech
# bridge and TimeTagger's API, for Home Assistant). 127.0.0.1 keeps them private to this machine.
LAN_BIND=127.0.0.1
# Network interface Glances reports on (the one with the default route).
NET_IFACE=eth0

# --- Your folders (created if missing) -------------------------------------
PHOTOS_DIR=/home/you/Pictures/Immich
BOOKS_DIR="/home/you/Calibre Library"
# Books copied here are imported into the library, then removed from here.
BOOKS_IMPORT_DIR=/home/you/Books/import
PAPERLESS_CONSUME_DIR=/home/you/Documents/Paperless

# --- Optional features -------------------------------------------------------
# Paperless AI: English summary, titles, receipt -> Actual Budget via Ollama.
# Needs the ollama and actual-budget stacks. Tuned for EUR receipts.
PAPERLESS_AI=no
# With PAPERLESS_AI=yes: no = receipts get an Amount but aren't posted to Actual.
PAPERLESS_ACTUAL_POST=yes
PAPERLESS_OCR_LANGUAGE=eng
# Extra OCR language packs to download, space separated (e.g. "spa bul").
PAPERLESS_OCR_LANGUAGES=
# Home Assistant on another machine: adds ha.$DOMAIN and a dashboard tile.
HA_URL=
# Weather on the dashboard (leave WEATHER_LAT empty to hide it).
WEATHER_LABEL=
WEATHER_LAT=
WEATHER_LON=

# --- Backups (optional, extras/backup) ----------------------------------------
# none | local | smb. local: BACKUP_DIR is a disk on this machine.
# smb: BACKUP_DIR is mounted from BACKUP_SMB_SHARE (credentials are asked
# for and stored root-only in /etc/homelab/smb-credentials).
BACKUP_TARGET=none
BACKUP_DIR=/mnt/backup
BACKUP_SMB_SHARE=//192.168.1.1/Backup
BACKUP_SCHEDULE=daily
# Hours (cron hour syntax) when heavy scheduled jobs may start, e.g. the
# night tariff: 23,0-5 = 23:00 to 05:59. Used by Paperless's classifier
# training; backups (daily = 00:00) and Immich's nightly jobs (00:00) are
# already inside it. Empty = any hour.
CHEAP_HOURS=
# Days of database dumps to keep; restic keeps 7 daily/4 weekly/6 monthly.
BACKUP_RETAIN_DAYS=14
# Optional off-site copy: a second restic repo (same password) that every
# run copies new snapshots to, e.g. rclone:gdrive:homelab/restic with the
# rclone remote in /etc/homelab/rclone.conf (see extras/backup/README.md).
BACKUP_OFFSITE=
# Upload cap for it in KiB/s (empty = no cap), e.g. 1500 for ~12 Mbit/s.
BACKUP_OFFSITE_LIMIT_KBPS=
# Repository name in Backrest (and its /repos/<name> mount).
BACKREST_REPO=main

# --- Private overlay (optional) ------------------------------------------------
# Absolute path to a folder (ideally its own private git repo) with
# machine-specific extras that don't belong in this public repo:
#   topology.md                your real map
#   homepage/<Group>.yaml      extra dashboard tiles for that group
#   caddy/sites/*.conf         extra routes on *.$DOMAIN
#   caddy/*.caddy              extra top-level Caddy sites
#   stacks/<stack>/*.yml       extra compose files for a stack
#   cloudflared.yml            extra tunnel ingress entries
# It's included in the nightly backup. See docs/private-overlay.md.
LOCAL_DIR=
